# Copy to web/.env.local (gitignored) and fill in.
# Supabase dashboard -> Project Settings -> API Keys (publishable key) / Data API (URL).
NEXT_PUBLIC_SUPABASE_URL=https://igirifwjpdcrxlourrsg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never NEXT_PUBLIC_). Google AI Studio -> API keys. Without it the summary falls back to a cited template and paste-a-listing is off.
GEMINI_API_KEY=
# Optional; defaults to gemini-flash-latest.
GEMINI_MODEL=

# Optional. Google Cloud API key with ONLY the Map Tiles API enabled (Photorealistic 3D Tiles).
# Shown in the browser, so restrict it in the Cloud console. Inlined at build time: restart
# `next dev` (or rebuild) after setting it. Without it the map's Flyover button doesn't render.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
