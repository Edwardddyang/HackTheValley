# Caddy gets and renews the HTTPS certificate for these names automatically, once the
# domain's DNS points at this server.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000 {
		# The brief page streams in (Partial Prerendering); pass bytes through without buffering.
		flush_interval -1
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
